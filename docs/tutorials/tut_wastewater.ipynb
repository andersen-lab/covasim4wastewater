    "import covasim as cv\n",
    "\n",
    "pars = dict(\n",
    "    pop_size = 2000,\n",
    "    pop_infected = 2,\n",
    "    start_day = '2020-04-01',\n",
    "    end_day = '2020-06-01',\n",
    ")\n",
    "sim = cv.Sim()\n",
    "sim.run()\n",
    "\n",
    "viral_loads = sim.people.viral_load\n",
    "print(viral_loads)"
